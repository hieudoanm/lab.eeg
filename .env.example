# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Client-side display limit for the recording upload form; keep in step with
# the API's MAX_UPLOAD_BYTES. The server remains the authority.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=268435456

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=neurolab-api
LOG_LEVEL=DEBUG
LOG_FORMAT=json
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://neurolab:neurolab@localhost:5432/neurolab
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=280
JOB_LEASE_SECONDS=120
ANALYSIS_MAX_ATTEMPTS=3
OUTBOX_DISPATCH_MAX_ATTEMPTS=10
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.local-data/uploads
GCS_BUCKET=
GCS_PROJECT=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# "development" enables the local POST /api/v1/auth/token endpoint.
# Production must use "oidc" and override AUTH_TOKEN_SECRET (or AUTH_PUBLIC_KEY).
AUTH_MODE=development
AUTH_TOKEN_SECRET=insecure-development-secret-change-me
# AUTH_PUBLIC_KEY=          # PEM public key for RS256/ES256 verification
AUTH_JWT_ALGORITHMS=HS256
AUTH_TOKEN_ISSUER=neurolab
AUTH_TOKEN_AUDIENCE=neurolab-api
AUTH_TOKEN_TTL_SECONDS=3600
# Session cookie for browser clients (HttpOnly)
AUTH_COOKIE_NAME=neurolab_session
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=          # defaults to true in production, false otherwise
# AUTH_COOKIE_DOMAIN=          # defaults to a host-only cookie
# Development identity defaults (used only when AUTH_MODE=development)
DEV_IDENTITY_PROVIDER=local
DEV_IDENTITY_SUBJECT=demo-researcher
DEV_IDENTITY_DISPLAY_NAME=Demo Researcher
DEV_IDENTITY_EMAIL=demo@neurolab.local
# Organisation seeded for a development user who belongs to none yet.
DEV_ORGANISATION_NAME=Development Organisation

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=268435456
MAX_CHANNELS=256
MAX_SAMPLE_COUNT=100000000
MAX_SIGNAL_WINDOW_SECONDS=300
MAX_SIGNAL_POINTS_PER_REQUEST=20000
MAX_REQUEST_BODY_BYTES=1048576
UPLOAD_SESSION_TTL_SECONDS=3600
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
