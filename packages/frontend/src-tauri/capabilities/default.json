{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "fs:default",
    "dialog:default",
    "notification:default",
    "fs:allow-app-write-recursive",
    "fs:allow-app-read-recursive"
  ]
}
