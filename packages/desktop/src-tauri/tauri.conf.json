{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neuro Lab",
  "version": "0.1.0",
  "identifier": "com.neurolab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Neuro Lab",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 600
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
